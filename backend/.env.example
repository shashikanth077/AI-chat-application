# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=your-key-here
# Pick a model your provider currently supports (see its model list page).
OPENAI_MODEL=your-model-name
# Optional. Leave empty for OpenAI. For Groq use: https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Embeddings for document search (Phase 12). Groq has no embeddings API, so this runs locally.
# fastembed = real semantic model, downloaded once (~130 MB) on first use.
# hashing   = offline word-matching embedder for tests/dev; matches shared words, NOT meaning.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
