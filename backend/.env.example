# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=your-key-here
# Pick a model your provider currently supports (see its model list page).
OPENAI_MODEL=your-model-name
# Optional. Leave empty for OpenAI. For Groq use: https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Embeddings for document search (Phase 12). Groq has no embeddings API, so this runs locally.
# fastembed = real semantic model, downloaded once (~130 MB) on first use.
# hashing   = offline word-matching embedder for tests/dev; matches shared words, NOT meaning.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Minimum similarity for a passage to count as relevant when answering from documents.
# Leave unset to use the embedding model's default (0.5 for bge-small). Tune it by looking at the scores in citations.
# RAG_MIN_SCORE=0.5

# Browser origins allowed to call this API (comma-separated). REQUIRED when the frontend is deployed
# somewhere other than localhost:5173, otherwise the browser blocks every request (CORS).
# CORS_ORIGINS=https://your-name.github.io,https://chat.your-domain.com

# Before searching, rewrite a follow-up question ("and how long do they nap?") into a standalone one using the
# recent conversation. Costs one small extra model call per follow-up. Set to false to turn it off.
# RAG_REWRITE_QUERIES=true
